# FlowMaster Distributed Task Orchestrator Environment Configuration

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:root@localhost:5432/bankproject
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=bankproject
PG_USER=postgres
PG_PASSWORD=root

# Microservice Ports
PORT_ORCHESTRATOR=5000
PORT_VERIFICATION=5001
PORT_CREDIT=5002

# Kafka Broker Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=flowmaster
KAFKA_GROUP_ID=flowmaster-group

# Redis & BullMQ Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Observability
PROMETHEUS_METRICS_ENABLED=true
JAEGER_ENDPOINT=http://localhost:4318/v1/traces
ENABLE_TRACING=true

# Application
NODE_ENV=development
LOG_LEVEL=info
ADMIN_SECRET_KEY=flowmaster-dev-secret-key-2026
